    (
        kind: Storage,
        name: "Storage",
        footprint: (1, 1),
        build_cost: [("wood", 5)],
    ),
    (
        kind: Workbench,
        name: "Workbench",
        footprint: (2, 1),
        build_cost: [("wood", 8), ("stone", 4)],
    ),
    (
        kind: Furnace,
        name: "Furnace",
        footprint: (1, 1),
        build_cost: [("stone", 10)],
    ),
]
