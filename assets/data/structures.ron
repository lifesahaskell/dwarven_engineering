// Buildable structures (docs/game-design/06-roadmap.md M3/M4) — storage, workbench, furnace,
// and the first Factory (Smelter). `Wall` (first defensive structure) arrives at M6.
[
    (
        kind: Storage,
        name: "Storage",
        footprint: (1, 1),
        build_cost: [("wood", 5)],
    ),
    (
        kind: Workbench,
        name: "Workbench",
        footprint: (2, 1),
        build_cost: [("wood", 8), ("stone", 4)],
    ),
    (
        kind: Furnace,
        name: "Furnace",
        footprint: (1, 1),
        build_cost: [("stone", 10)],
    ),
    (
        kind: Factory(Smelter),
        name: "Smelter",
        footprint: (1, 1),
        build_cost: [("stone", 15), ("ore", 5)],
    ),
]
