// Tier 0/1 hand-craft only, plus the first Tier 2 automated recipe (docs/game-design/06-roadmap.md
// M2/M4). `station`/`craft_time_secs` aren't enforced for hand-crafting (any recipe can be
// hand-crafted regardless of station) — `factory_sim::run_factories` is the first system that
// actually reads `craft_time_secs`.
[
    (
        id: "axe",
        inputs: [("wood", 3), ("stone", 2)],
        outputs: [("axe", 1)],
        craft_time_secs: 2.0,
        station: HandCraft,
    ),
    (
        id: "pickaxe",
        inputs: [("wood", 2), ("stone", 3)],
        outputs: [("pickaxe", 1)],
        craft_time_secs: 2.0,
        station: HandCraft,
    ),
    (
        id: "ingot",
        inputs: [("ore", 1)],
        outputs: [("ingot", 1)],
        craft_time_secs: 2.0,
        station: Furnace,
        requires_tech: Some("early_automation"),
    ),
]
